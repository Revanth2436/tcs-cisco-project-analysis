# ── Copy this file to .env and fill in your values ──

# Groq API Key (required — free at console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# AI Provider for analysis: groq | gemini | mistral
AI_PROVIDER=groq

# Gemini API Key (optional — free at aistudio.google.com)
GEMINI_API_KEY=

# Mistral API Key (optional — free at console.mistral.ai)
MISTRAL_API_KEY=

# Supabase (optional — free at supabase.com)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server port
PORT=3000
